# Required: replace these values before starting Northbound.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-value

# The address people use to open Northbound. Include the scheme and port.
NORTHBOUND_URL=http://localhost:8000
NORTHBOUND_PORT=8000
NORTHBOUND_BIND_ADDRESS=0.0.0.0

# Safe defaults for the bundled self-hosted deployment.
DJANGO_DEBUG=0
NORTHBOUND_SERVE_MEDIA=1
NORTHBOUND_TRUST_PROXY_HEADERS=0
TIME_ZONE=America/New_York

# PostgreSQL runs inside Compose. Change these only if you know you need to.
POSTGRES_DB=northbound
POSTGRES_USER=northbound

# Optional advanced overrides:
# DJANGO_ALLOWED_HOSTS=northbound.example.com,192.168.1.20
# DJANGO_CSRF_TRUSTED_ORIGINS=https://northbound.example.com
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_SSL_REDIRECT=0
# DJANGO_SECURE_HSTS_SECONDS=0
# WEB_CONCURRENCY=2
# PORT=8000
# HARDCOVER_GRAPHQL_URL=https://api.hardcover.app/v1/graphql
# NORTHBOUND_TOKEN_ENCRYPTION_KEY=optional-dedicated-fernet-key
# NORTHBOUND_MAX_PROFILE_PICTURE_BYTES=10485760
# NORTHBOUND_MAX_REQUEST_BYTES=11534336
