DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
NORTHBOUND_TOKEN_ENCRYPTION_KEY=replace-this-with-a-fernet-key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,northbound.deepnorth.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://northbound.deepnorth.app
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
POSTGRES_DB=reading_challenge
POSTGRES_USER=reading_challenge
POSTGRES_PASSWORD=replace-this-database-password
DATABASE_URL=postgresql://reading_challenge:replace-this-database-password@db:5432/reading_challenge
TIME_ZONE=America/New_York
HARDCOVER_GRAPHQL_URL=https://api.hardcover.app/v1/graphql
NORTHBOUND_IMAGE=ghcr.io/yetti7/northbound:latest
NORTHBOUND_DATA_DIR=/srv/appdata/northbound
NORTHBOUND_BIND_ADDRESS=127.0.0.1
NORTHBOUND_PORT=8000
