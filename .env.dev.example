# DEVELOPMENT ONLY. Generate fresh values; never copy production secrets.
DJANGO_SECRET_KEY=replace-with-a-fresh-development-secret
NORTHBOUND_TOKEN_ENCRYPTION_KEY=
DJANGO_DEBUG=0
NORTHBOUND_URL=http://localhost:8061
NORTHBOUND_SQLITE_PATH=/data/northbound.sqlite3
NORTHBOUND_MEDIA_ROOT=/data/media
NORTHBOUND_SERVE_MEDIA=1
PORT=8000
WEB_CONCURRENCY=1
NORTHBOUND_BACKUP_SCHEDULER_ENABLED=0
NORTHBOUND_CHALLENGE_SCHEDULER_ENABLED=0
NORTHBOUND_HARDCOVER_WRITEBACK_ENABLED=0
NORTHBOUND_DEVELOPMENT_BANNER=1
DJANGO_SESSION_COOKIE_NAME=northbound_dev_sessionid
DJANGO_CSRF_COOKIE_NAME=northbound_dev_csrftoken
TIME_ZONE=America/New_York
# Leave DATABASE_URL and POSTGRES_HOST unset for SQLite.
# Adjust NORTHBOUND_URL and allowed hosts/origins for the future Tailscale address.
